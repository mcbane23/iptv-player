<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Snimci i preuzeto idu u Downloads/Glowbox. Od Androida 11 za to ne treba dozvola; na starijim treba. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!--
        TV: uvoz podešavanja čita fajl iz Downloads/Glowbox koji ova instalacija nije sama napravila
        (prenet sa drugog uređaja ili ostao od ranije instalacije). Od Androida 11 to traži pristup
        svim fajlovima, koji korisnik sam uključuje na sistemskom ekranu.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Preuzimanje na telefon ide samo preko Wi-Fi mreže, pa aplikacija mora da zna na kojoj je mreži. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- TV: upis započetih filmova i serija u red „Nastavite sa gledanjem” na početnom ekranu uređaja. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- Android 17+: pristup uređajima u kućnoj mreži (cast, dodavanje liste sa telefona). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Ažuriranje iz aplikacije: instaliranje preuzetog APK-a (korisnik potvrđuje). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 14+: sledeće ažuriranje može bez potvrde kad je aplikacija već instalirala sebe. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Snimanje kanala traje i kad aplikacija nije na ekranu (obaveštenje sa dugmetom za zaustavljanje). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Puštanje u pozadini na telefonu (opcija u podešavanjima): zvuk ide i kad je ekran ugašen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Snimanje ne sme da stane kad se ekran ugasi. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Zakazano snimanje kreće tačno na vreme (budilnik). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Pokretanje pri paljenju uređaja (isključeno dok ga korisnik ne uključi u podešavanjima). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Od Androida 10 aplikacija sme sama da se otvori posle paljenja samo uz ovu dozvolu. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Jedan APK za telefon i TV: ni ekran na dodir ni leanback nisu obavezni. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- Glasovna pretraga na TV-u: da se vidi da li uređaj ima sistemsko prepoznavanje govora. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- Mnogi IPTV provajderi rade samo preko običnog HTTP-a, zato je cleartext dozvoljen. -->
    <application
        android:name=".IptvApplication"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.IptvPlayer">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Link sa stranice TV-a (posle skeniranja QR koda) otvara slanje svih lista na TV. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="send"
                    android:scheme="iptvplayer" />
            </intent-filter>
        </activity>

        <!-- Google Cast (slanje sa telefona na Chromecast): klasa sa podešavanjima. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.bane23.iptvplayer.cast.CastOptionsProvider" />

        <service
            android:name=".data.recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Recording a live TV stream chosen by the user to a local file" />
        </service>

        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Downloading a movie or episode chosen by the user to a local file for offline viewing" />
        </service>

        <service
            android:name=".player.background.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".data.recording.RecordingAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.reminder.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".work.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false" />
        <!-- Posle ažuriranja iz aplikacije nova verzija se sama ponovo otvara (gde sistem dozvoli). -->
        <receiver
            android:name=".data.update.UpdateFinishedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
